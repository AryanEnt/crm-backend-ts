# Local development — copy to .env. Never commit real secrets.
APP_ENV=development
# Railway injects PORT. Locally 8081 keeps the Go backend free to use 8080.
PORT=8081
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm?sslmode=disable
# Must equal the Go backend's JWT_SECRET while both run, so sessions work on either.
JWT_SECRET=dev-only-change-me-in-production-use-long-secret
# Encrypts Gmail OAuth tokens at rest (falls back to JWT_SECRET). Must equal Go's while both run.
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
# Base for the Google OAuth redirect URI and Twilio status callbacks; must match what Google has registered.
PUBLIC_API_URL=http://localhost:8081

# Switch-over only: every route is ported, and anything unknown is forwarded here while Go
# still runs. Leave empty to run standalone (unknown routes return 404, workers default on).
GO_BACKEND_URL=http://localhost:8080
# Run the automation worker in this process. Defaults to true only when GO_BACKEND_URL is empty,
# so it never runs alongside Go's worker by accident.
# AUTOMATION_WORKER=false
# Gmail watch renewal and scheduled sends; same default and reasoning as AUTOMATION_WORKER.
# EMAIL_WORKER=false

# Used by `npm run seed` only when the users table is empty.
# Required when APP_ENV is not development (password: 12+ characters).
# In development, empty values fall back to admin@crm.local / ChangeMe123!.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# Lead screenshots are stored in Cloudflare R2. All four are required.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
