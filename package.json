{
  "name": "crm-backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node dist/cli/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "node dist/cli/seed.js",
    "seed:dev": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "db:types": "kysely-codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "imapflow": "^2.9.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
